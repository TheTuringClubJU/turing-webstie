# Runtime backend settings.
DATABASE_URL=postgresql://user:password@localhost:5432/apply
APPLICATION_CYCLE=2026-hiring
CORS_ORIGINS=http://localhost:5173
APP_ENV=development

# Storage service configuration. Supply credentials through a local .env file.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-minio-service-account
MINIO_SECRET_KEY=replace-with-minio-secret
MINIO_BUCKET=resumes
MINIO_SECURE=false

# Email service configuration. Use a Brevo SMTP key, not an account password.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=replace-with-brevo-login
BREVO_SMTP_KEY=replace-with-brevo-smtp-key
EMAIL_FROM=replace-with-verified-sender@example.com
EMAIL_FROM_NAME=Turing Club

# Neon DIRECT connection string (the host WITHOUT "-pooler"). Used to create/update the tables.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Throwaway local Postgres used ONLY by the tests. Never point this at Neon production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost/apply_test

# Maximum accepted PDF resume size.
MAX_RESUME_MB=5
